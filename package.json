{
  "name": "connector-router",
  "version": "0.1.0",
  "description": "Safety-first local action router for agent connector selection and dry-run planning",
  "type": "module",
  "bin": {
    "connector-router": "src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/*.js test/*.test.js",
    "build": "node scripts/validate.js",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "agent-skill",
    "dry-run",
    "cli",
    "oss"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "docs",
    "fixtures",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-router.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-router/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-router#readme",
  "author": "Roger Chappel"
}
